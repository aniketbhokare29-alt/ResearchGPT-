APP_NAME=ResearchGPT
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+psycopg://researchgpt:researchgpt@localhost:5432/researchgpt
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=60
MAX_PDF_SIZE_MB=25
UPLOAD_DIRECTORY=../data/uploads
VECTOR_INDEX_DIRECTORY=../data/indexes
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SUMMARY_MODEL_NAME=sshleifer/distilbart-cnn-12-6
MODEL_DEVICE=auto
EMBEDDING_BATCH_SIZE=24
CHUNK_SIZE_WORDS=140
CHUNK_OVERLAP_WORDS=28
SUMMARY_MAX_INPUT_TOKENS=850
SUMMARY_MAX_OUTPUT_TOKENS=120

